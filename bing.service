[Unit]
Description=Bing Wallpaper Go Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bing
Group=bing
WorkingDirectory=/opt/bing
ExecStart=/opt/bing/bing -config /opt/bing/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
